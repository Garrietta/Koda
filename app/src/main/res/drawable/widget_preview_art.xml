<?xml version="1.0" encoding="utf-8"?>
<!--
    Picker preview for Vinyl: stand-in album art in Rondo's own colors,
    orange through orchid to iris, as the brand's record is. The other
    widgets' previews are rendered from the widgets themselves
    (tools/widget_previews.py); Vinyl draws its own views, so it keeps this.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FFFF7A45"
        android:centerColor="#FFC77DF2"
        android:endColor="#FF5B4BFF" />
    <corners android:radius="16dp" />
</shape>
