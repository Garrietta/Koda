<?xml version="1.0" encoding="utf-8"?>
<!-- NOTE: RemoteViews cannot inflate bare android.view.View (host throws "Class not allowed to be inflated") — spacers and tap targets must be FrameLayout. -->
<!--
    Vinyl widget, classic RemoteViews shell — NARROW variant (cell aspect <= 2.205).

    WHY THIS FILE EXISTS: Glance composes to a fixed dp size chosen from the
    launcher's reported size, and One UI's content-size % scales that report,
    so every Glance-era vinyl build shrank at 110%. This shell has NO dp
    size anywhere: the root is match_parent, every child is 0dp plus a
    layout_weight, and the artwork bitmaps are drawn with fitCenter, so the
    launcher — not widget dp math — scales the design to the true host box.
    The % slider cannot shrink it, because nothing in this layout reads a
    reported size. The only reported-size use in the whole widget is the
    provider's choice between this file and widget_vinyl_wide, by aspect
    ratio, which a uniform % scale cannot change.

    GEOMETRY (fractions of the stage rect, from Cookie4Sided true bounds,
    fill ~0.94): stage width = 1 + 0.75 x 0.94 = 1.705 heights; the row is
    stage 1705 / gap 40 / buttons 460 = 2.205 heights at design ratio.
    Inside the stage rect: sleeve 0.586 wide, record carve left 0.311 /
    width 0.551 / right 0.138, vertical top 0.03 / height 0.94 / bottom 0.03.
    The record carve holds the parked label, the spinning label and the
    spindle, so all three track the disc exactly at every size: the carve
    is weight fractions of the art rect, and the art rect is the
    adjustViewBounds box of the disc bitmap (see the provider).

    LAYERING (z-order in this file): disc layer, carve, top layer, taps.
    The top layer (sleeve + arm) draws OVER the carve, so the sleeve
    occludes the label's and spindle's left half: the disc sits behind
    the sleeve, and no disc element can paint over the album art. The
    disc and top bitmaps share the stage rect exactly, so both
    adjustViewBounds boxes coincide.

    SPIN: the label is a DETERMINATE ProgressBar whose progress drawable
    is the rotate drawable, so progress 0..3600 is the angle 0..360
    degrees. The app owns the angle and pushes it (see VinylClassic):
    pause freezes it, only a new track resets it to 0.

    NARROW vs WIDE: in this variant the stage bitmap is width-driven
    (width match_parent, height wrap_content + adjustViewBounds), which
    yields the true art rect when the cell is narrower than the design
    ratio. The wide variant flips the axis. Same design, same side column
    — not a reflow, only the measurement axis changes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Stage: disc layer, carve, top layer — see header. -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1705">

            <ImageView
                android:id="@+id/vinyl_disc_art"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />

            <!-- Record carve: fractions of the art rect, so the label and
                 spindle sit on the disc at every size and ratio. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignLeft="@id/vinyl_disc_art"
                android:layout_alignRight="@id/vinyl_disc_art"
                android:layout_alignTop="@id/vinyl_disc_art"
                android:layout_alignBottom="@id/vinyl_disc_art"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="30" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="940"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="311" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="551">

                        <ImageView
                            android:id="@+id/vinyl_label_parked"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter" />

                        <ProgressBar
                            android:id="@+id/vinyl_label_spin"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:indeterminateOnly="false"
                            android:max="3600"
                            android:progress="0"
                            android:progressDrawable="@drawable/vinyl_spin"
                            android:maxHeight="2000dp"
                            android:maxWidth="2000dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp" />

                        <ImageView
                            android:id="@+id/vinyl_spindle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter" />

                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="138" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="30" />

            </LinearLayout>

            <!-- Top layer: sleeve + arm, over the carve (see header). -->
            <ImageView
                android:id="@+id/vinyl_top_art"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />

            <!-- Tap targets, fractions of the art rect: sleeve opens the app,
                 the record-only strip toggles playback. Transparent, on top. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignLeft="@id/vinyl_disc_art"
                android:layout_alignRight="@id/vinyl_disc_art"
                android:layout_alignTop="@id/vinyl_disc_art"
                android:layout_alignBottom="@id/vinyl_disc_art"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/vinyl_tap_sleeve"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="586" />

                <FrameLayout
                    android:id="@+id/vinyl_tap_record"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="414" />

            </LinearLayout>

        </RelativeLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="40" />

        <!-- Transport column: play and next, each 0.48 of the height. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="460"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/vinyl_btn_play"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="480"
                android:scaleType="fitCenter" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="40" />

            <ImageView
                android:id="@+id/vinyl_btn_next"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="480"
                android:scaleType="fitCenter" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
