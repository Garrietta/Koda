<?xml version="1.0" encoding="utf-8"?>
<!--
    The Vinyl widget's label rotation. Same mechanism as widget_vinyl_spin:
    an indeterminate ProgressBar animated by the launcher, with a rotate
    drawable in place of the usual spinner. Same 1.8s duration and linear
    interpolator, so the label turns at exactly the same speed and in the same
    direction as the print spinner. The tint is set from VinylWidget.
-->
<ProgressBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vinyl_label_spin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:indeterminate="true"
    android:indeterminateBehavior="repeat"
    android:indeterminateDrawable="@drawable/vinyl_label_spin"
    android:indeterminateDuration="1800"
    android:indeterminateOnly="true"
    android:interpolator="@android:anim/linear_interpolator"
    android:maxHeight="2000dp"
    android:maxWidth="2000dp"
    android:minHeight="0dp"
    android:minWidth="0dp" />
